#!/usr/bin/env bash
set -euo pipefail

APP_NAME="IME Safe AI CLI Terminal"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PASTE_SCRIPT="$SCRIPT_DIR/ai-cli-paste"
LOG_DIR="$HOME/Library/Logs/IME Safe AI CLI Terminal"
LOG_FILE="$LOG_DIR/app.log"

mkdir -p "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
printf '\n[%s] launch PATH=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$PATH"

target="claude"
session="claude"

has() {
  command -v "$1" >/dev/null 2>&1
}

alert() {
  osascript <<OSA >/dev/null || true
display alert "$APP_NAME" message "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')" as informational
OSA
}

choose_button() {
  local message="$1"
  local buttons="$2"
  local default_button="$3"
  osascript <<OSA 2>/dev/null || true
button returned of (display dialog "$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')" buttons {$buttons} default button "$default_button" with title "$APP_NAME")
OSA
}

choose_from_list() {
  local prompt="$1"
  local items="$2"
  osascript <<OSA 2>/dev/null || true
set chosenItem to choose from list {$items} with prompt "$(printf '%s' "$prompt" | sed 's/\\/\\\\/g; s/"/\\"/g')" with title "$APP_NAME" default items {"Claude Code"}
if chosenItem is false then
  return ""
else
  return item 1 of chosenItem
end if
OSA
}

shell_quote() {
  printf '%q' "$1"
}

terminal_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

detect_cli() {
  case "$1" in
    claude)
      command -v claude 2>/dev/null || {
        [ -x "$HOME/.local/bin/claude" ] && printf '%s\n' "$HOME/.local/bin/claude"
      } || true
      ;;
    codex)
      command -v codex 2>/dev/null || {
        [ -x "/Applications/ChatGPT.app/Contents/Resources/codex" ] && printf '%s\n' "/Applications/ChatGPT.app/Contents/Resources/codex"
      }
      ;;
    gemini)
      command -v gemini 2>/dev/null || {
        [ -x "$HOME/.local/bin/gemini" ] && printf '%s\n' "$HOME/.local/bin/gemini"
      } || true
      ;;
  esac
}

set_target_from_label() {
  case "$1" in
    "Claude Code")
      target="claude"
      session="claude"
      ;;
    "Codex")
      target="codex"
      session="codex"
      ;;
    "Gemini CLI")
      target="gemini"
      session="gemini"
      ;;
  esac
}

check_tmux() {
  if has tmux; then
    return 0
  fi

  if ! has brew; then
    alert "tmux is required, but Homebrew was not found. Install Homebrew first, then run: brew install tmux"
    return 1
  fi

  choice="$(choose_button "tmux is required to keep AI CLI sessions open safely. Install tmux now with Homebrew?" '"Cancel", "Install tmux"' "Install tmux")"
  case "$choice" in
    "Install tmux")
      osascript >/dev/null <<'OSA'
tell application "Terminal"
  activate
  do script "brew install tmux"
end tell
OSA
      alert "A Terminal window is installing tmux. Run this app again after installation finishes."
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

choose_target() {
  choice="$(choose_from_list "Choose the AI CLI you want to run." '"Claude Code", "Codex", "Gemini CLI"')"
  [ -n "$choice" ] || return 1
  set_target_from_label "$choice"

  cli_path="$(detect_cli "$target")"
  if [ -z "$cli_path" ]; then
    alert "$choice was not found on this Mac. Install or log in to that CLI first, then open this app again."
    return 1
  fi
}

open_session() {
  check_tmux || return 1
  cli_path="$(detect_cli "$target")"
  if [ -z "$cli_path" ]; then
    alert "$target was not found on this Mac. Install or log in to it first."
    return 1
  fi

  session_cmd="tmux new-session -A -s $(shell_quote "$session") $(shell_quote "$cli_path")"
  escaped_cmd="$(terminal_escape "$session_cmd")"
  osascript >/dev/null <<OSA
tell application "Terminal"
  activate
  do script "$escaped_cmd"
end tell
OSA
  alert "Opened $target in a tmux session named '$session'. Keep that Terminal window open."
}

send_clipboard() {
  check_tmux || return 1
  if ! tmux has-session -t "$session" 2>/dev/null; then
    alert "No '$session' session is running yet. Open the AI CLI session first."
    return 1
  fi

  choice="$(choose_button "Send the current clipboard to '$session'?" '"Cancel", "Paste only", "Paste and Enter"' "Paste and Enter")"
  case "$choice" in
    "Paste and Enter")
      output="$("$PASTE_SCRIPT" "$session" --enter 2>&1)" || {
        alert "$output"
        return 1
      }
      alert "$output"
      ;;
    "Paste only")
      output="$("$PASTE_SCRIPT" "$session" 2>&1)" || {
        alert "$output"
        return 1
      }
      alert "$output"
      ;;
    *)
      return 1
      ;;
  esac
}

open_github() {
  open "https://github.com/jeff-jung0531/ime-safe-ai-cli-terminal"
}

main_menu() {
  while true; do
    choice="$(choose_button "Target: $target\n\nChoose what to do next." '"Quit", "GitHub", "Send Clipboard", "Open AI CLI"' "Open AI CLI")"
    printf '[%s] menu choice=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${choice:-<empty>}"
    case "$choice" in
      "Open AI CLI")
        choose_target && open_session || true
        ;;
      "Send Clipboard")
        send_clipboard || true
        ;;
      "GitHub")
        open_github
        ;;
      "")
        alert "The app could not show its menu or the dialog was dismissed. Please try opening it again. Log: $LOG_FILE"
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
  done
}

main_menu
