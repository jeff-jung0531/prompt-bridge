#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Applications/ChatGPT.app/Contents/Resources:${PATH:-}"

usage() {
  cat <<'EOF'
AI CLI Paste Shield

Paste completed text into an existing tmux session using bracketed paste.

Usage:
  ai-cli-paste [session] [options]

Options:
  --enter        Send Enter after paste
  --no-bracket   Disable tmux bracketed paste mode
  --file PATH    Paste from file instead of macOS clipboard
  --stdin        Read text from stdin instead of macOS clipboard
  --list         List tmux sessions
  --dry-run      Print planned action without pasting
  --help         Show this help

Examples:
  ai-cli-paste claude
  ai-cli-paste claude --enter
  ai-cli-paste codex --file prompt.txt --enter
  echo "hello" | ai-cli-paste claude --enter
  ai-cli-paste --list
EOF
}

die() {
  printf 'ai-cli-paste: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

session=""
send_enter=0
bracketed=1
input_file=""
use_stdin=0
dry_run=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --enter)
      send_enter=1
      ;;
    --no-bracket)
      bracketed=0
      ;;
    --file)
      shift
      [ "$#" -gt 0 ] || die "--file requires a path"
      input_file="$1"
      ;;
    --stdin)
      use_stdin=1
      ;;
    --list)
      need tmux
      tmux list-sessions
      exit 0
      ;;
    --dry-run)
      dry_run=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [ -z "$session" ] || die "only one session can be provided"
      session="$1"
      ;;
  esac
  shift
done

need tmux

if [ -z "$session" ]; then
  session="$(tmux display-message -p '#S' 2>/dev/null || true)"
fi

[ -n "$session" ] || die "provide a tmux session name, or run from inside tmux"
tmux has-session -t "$session" 2>/dev/null || die "tmux session not found: $session"

tmp_file="$(mktemp "${TMPDIR:-/tmp}/ai-cli-paste.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT

if [ -n "$input_file" ] && [ "$use_stdin" -eq 1 ]; then
  die "use either --file or --stdin, not both"
fi

if [ -n "$input_file" ]; then
  [ -f "$input_file" ] || die "file not found: $input_file"
  cp "$input_file" "$tmp_file"
elif [ "$use_stdin" -eq 1 ]; then
  cat > "$tmp_file"
else
  need pbpaste
  pbpaste > "$tmp_file"
fi

[ -s "$tmp_file" ] || die "input is empty"

byte_count="$(wc -c < "$tmp_file" | tr -d ' ')"
line_count="$(wc -l < "$tmp_file" | tr -d ' ')"

if [ "$dry_run" -eq 1 ]; then
  printf 'session: %s\n' "$session"
  printf 'input: %s bytes, %s lines\n' "$byte_count" "$line_count"
  printf 'bracketed paste: %s\n' "$([ "$bracketed" -eq 1 ] && printf yes || printf no)"
  printf 'send enter: %s\n' "$([ "$send_enter" -eq 1 ] && printf yes || printf no)"
  exit 0
fi

tmux load-buffer -b ai-cli-paste "$tmp_file"

if [ "$bracketed" -eq 1 ]; then
  tmux paste-buffer -b ai-cli-paste -t "$session" -p
else
  tmux paste-buffer -b ai-cli-paste -t "$session"
fi

if [ "$send_enter" -eq 1 ]; then
  tmux send-keys -t "$session" Enter
fi

printf 'pasted %s bytes into tmux session "%s"' "$byte_count" "$session"
if [ "$send_enter" -eq 1 ]; then
  printf ' and sent Enter'
fi
printf '\n'
